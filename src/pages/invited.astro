---
// 14 · Invited to Jeevanto: a holding page until ENGINES' invite door is built in (cc-website-01 JOB 2).
import Holding from '../components/Holding.astro';
import { config } from '../lib/config.mjs';
const lede = "font-family:'Newsreader',serif; font-size:var(--lede); line-height:var(--ledelh); color:var(--ink); text-wrap:pretty;";
---
<Holding title="Invited to Jeevanto" path="/invited" eyebrow="INVITED TO JEEVANTO" heading="Jeevanto isn’t open yet." description="You’ve been invited to Jeevanto.">
  <p style={lede}>When it is, get the app, open it, and enter the code from the message you were sent.</p>
  <p style="font-size:15px; line-height:21px; color:var(--quiet); text-wrap:pretty;">Want to hear when we’re live? Write to <a href={`mailto:${config.supportEmail}`} style="color:var(--brass); font-weight:600;">{config.supportEmail}</a>.</p>
</Holding>
