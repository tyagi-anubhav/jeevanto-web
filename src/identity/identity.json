 "orb-dark-140": "<div class=\"orb-root\" style=\"width: 202px; height: 202px; position: relative; --wander-boost: 0px; --speed: 1;\"><div style=\"position: absolute; inset: 0px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 153, 51, 0.22) 0%, rgba(220, 110, 40, 0.08) 40%, transparent 70%); filter: blur(25.2px); opacity: 1; transition: opacity 500ms ease-out;\"></div><div style=\"position: absolute; left: 50%; top: 50%; width: 140px; height: 140px; margin-left: -70px; margin-top: -70px; border-radius: 50%; transition: transform 500ms ease-out, filter 500ms ease-out; transform: scale(1); filter: none; animation: 7s ease-in-out 0s infinite normal none running orb-breathe;\"><div class=\"orb-layer\" style=\"position: absolute; inset: 0px; border-radius: 50%; background: radial-gradient(circle at 50% 55%, rgba(42, 34, 48, 0.95) 0%, rgb(24, 20, 28) 45%, rgb(12, 10, 14) 100%); box-shadow: rgba(255, 200, 140, 0.07) 12.6px 12.6px 23.8px inset, rgba(0, 0, 0, 0.7) -8.4px -9.8px 35px inset, rgba(220, 165, 90, 0.14) 0px 0px 42px;\"></div><div class=\"orb-layer orb-wander\" style=\"position: absolute; inset: 10% 12% 12%; border-radius: 50%; background: radial-gradient(circle, rgba(255, 190, 110, 0.85) 0%, rgba(255, 153, 51, 0.6) 35%, rgba(220, 110, 30, 0.3) 70%, transparent 95%); filter: blur(14px); animation-duration: 20.8s; animation-play-state: running;\"></div><div class=\"orb-layer\" style=\"position: absolute; inset: 8% 12% 60% 14%; border-radius: 50%; background: radial-gradient(at 50% 30%, rgba(255, 235, 210, 0.22) 0%, transparent 60%); mix-blend-mode: screen; opacity: 1;\"></div></div></div>",
